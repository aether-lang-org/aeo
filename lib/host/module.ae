// lib/host — host-profile probe and capability gating.
//
// aeo adapts to whether the host is BSD or Linux and fast-fails grammar
// the host can't honor. Two layers (per aeo-design.md § Host adaptation):
//
//   (a) backend selection — a `uname`-style profile that says which
//       driver family (`bsd` / `linux` / `other`) runs here, so a
//       `kind(...)` the host can't execute is a fast, loud error at
//       composition-evaluation time, not a silent no-op three nodes deep.
//   (b) capability probes — `capsicum.available()` / `casper.available()`
//       already return 0 off-FreeBSD and degrade cleanly. aeo CONSUMES
//       this contract; it does not reinvent Capsicum host-detection.
//
// The local host profile is derived from `os.platform()` (compile-time,
// == the orchestrator's own OS, which is the host it drives locally) and
// confirmed/printed via a runtime `uname -s`. Remote/nested-virt targets
// gate on the *target's* profile, which a future remote driver supplies;
// this module is the local case.

import std.os (platform, run_capture, getenv)
import std.capsicum
import std.casper
import std.list
import std.string (string_length, string_char_at, string_substring)

exports (
    profile, is_bsd, is_linux, family,
    uname_s, capsicum_available, casper_available,
    pkg_manager, pkg_install
)

// The host family aeo selects a driver against. One of:
//   "bsd"    FreeBSD (jail / bhyve)
//   "linux"  Linux   (lxc / docker / kvm)
//   "other"  anything else — only driver_stub (fail-loud) resolves
family() -> string {
    p = platform()
    if p == "freebsd" {
        return "bsd"
    }
    // openbsd/netbsd/dragonfly are BSD kernels but aeo's BSD driver
    // targets FreeBSD jails specifically, so they fall to "other" until
    // a driver exists. Keep this explicit rather than prefix-matching.
    if p == "linux" {
        return "linux"
    }
    return "other"
}

// 1 if the local host is FreeBSD, else 0.
is_bsd() -> int {
    if family() == "bsd" {
        return 1
    }
    return 0
}

// 1 if the local host is Linux, else 0.
is_linux() -> int {
    if family() == "linux" {
        return 1
    }
    return 0
}

// `uname -s` of the running host (runtime, not compile-time). Used for
// the human-facing profile line and as the seed for remote-host gating
// later. Returns "" if uname can't be run.
uname_s() -> string {
    av = list_new()
    list_add(av, "-s")
    out, status, err = run_capture("/usr/bin/uname", av, null)
    list_free(av)
    if err != "" {
        // Fall back to the busybox/path-less location some hosts use.
        return ""
    }
    // Trim the trailing newline uname emits.
    return _chomp(out)
}

// 1 if Capsicum is usable on this host right now, 0 otherwise. Thin
// pass-through to the std contract so callers read it from one place.
capsicum_available() -> int {
    return capsicum.available()
}

// 1 if Casper (DNS/passwd/sysctl delegation) is usable right now, else 0.
casper_available() -> int {
    return casper.available()
}

// A one-line human-facing host profile, e.g.
//   "host: linux (family=linux, capsicum=no, casper=no)"
profile() -> string {
    u = uname_s()
    if u == "" {
        u = platform()
    }
    cap = "no"
    if capsicum_available() == 1 {
        cap = "yes"
    }
    cas = "no"
    if casper_available() == 1 {
        cas = "yes"
    }
    return "host: ${u} (family=${family()}, capsicum=${cap}, casper=${cas})"
}

// Strip a single trailing newline (uname/command output convention).
_chomp(s: string) -> string {
    n = string_length(s)
    if n == 0 {
        return s
    }
    last = string_char_at(s, n - 1)
    if last == 10 {
        return string_substring(s, 0, n - 1)
    }
    return s
}

// --- portable package install (substrate self-bootstrap) --------------------
//
// The fleet is not apt-only: Debian/RaspiOS (apt), Fedora/Bazzite (dnf), RHEL
// (yum), openSUSE (zypper), Arch (pacman), Alpine (apk), FreeBSD (pkg), macOS
// (brew). A driver that wants to self-install its substrate engine (podman, lxc,
// systemd-container, ...) calls host.pkg_install; it detects the manager present
// and issues the right non-interactive install. So "silent install" works beyond
// apt-get.

// The package manager on this host, by first-present PATH probe. "" if none
// recognised (a locked-down or exotic host — the caller then no-ops cleanly).
pkg_manager() -> string {
    if _have("apt-get") == 1 { return "apt" }
    if _have("dnf") == 1     { return "dnf" }
    if _have("yum") == 1     { return "yum" }
    if _have("zypper") == 1  { return "zypper" }
    if _have("pacman") == 1  { return "pacman" }
    if _have("apk") == 1     { return "apk" }
    if _have("pkg") == 1     { return "pkg" }     // FreeBSD
    if _have("brew") == 1    { return "brew" }    // macOS
    return ""
}

// Install `pkg` if `have_cmd` (a binary name to `command -v`) is not already
// present. Portable across the managers above; retried (transient lock/network);
// silent + best-effort. Opt-out AEO_LINUX_AUTOINSTALL=0. Returns "" on success
// (or already-present / opted-out / no manager — all non-fatal), else a short
// note. The caller re-checks the real capability afterward (this is best-effort).
//   host.pkg_install("podman", "podman")
//   host.pkg_install("systemd-container", "machinectl")
//   host.pkg_install("lxc lxc-templates debootstrap", "lxc-create")   // apt names
pkg_install(pkg: string, have_cmd: string) -> string {
    off = getenv("AEO_LINUX_AUTOINSTALL")
    if off != null {
        if off == "0" {
            return ""
        }
    }
    mgr = pkg_manager()
    if string_length(mgr) == 0 {
        return "no known package manager"
    }
    inst = _install_cmd(mgr, pkg)
    if string_length(inst) == 0 {
        return "unsupported manager ${mgr}"
    }
    // retry up to 5x: skip if have_cmd already there; else install; succeed as
    // soon as it appears. brew must NOT run under sudo; the others need -n sudo.
    guard = ""
    if string_length(have_cmd) > 0 {
        guard = "command -v ${have_cmd} >/dev/null 2>&1 && exit 0; "
    }
    check = ""
    if string_length(have_cmd) > 0 {
        check = " && command -v ${have_cmd} >/dev/null 2>&1 && exit 0"
    }
    line = "${guard}i=0; while [ $i -lt 5 ]; do ${inst}${check}; i=$((i+1)); sleep 5; done"
    av = list_new()
    list_add(av, "-c")
    list_add(av, line)
    _o, _s, _e = run_capture("/bin/sh", av, null)
    list_free(av)
    return ""
}

// The non-interactive install invocation for a manager. sudo -n for the
// system managers (operator pre-authorizes NOPASSWD, the fleet contract); brew
// runs as the user (never sudo). "" for an unknown manager.
_install_cmd(mgr: string, pkg: string) -> string {
    if mgr == "apt" {
        return "sudo -n DEBIAN_FRONTEND=noninteractive apt-get update -qq && sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ${pkg}"
    }
    if mgr == "dnf" {
        return "sudo -n dnf install -y -q ${pkg}"
    }
    if mgr == "yum" {
        return "sudo -n yum install -y -q ${pkg}"
    }
    if mgr == "zypper" {
        return "sudo -n zypper --non-interactive install ${pkg}"
    }
    if mgr == "pacman" {
        return "sudo -n pacman -Sy --noconfirm ${pkg}"
    }
    if mgr == "apk" {
        return "sudo -n apk add --no-progress ${pkg}"
    }
    if mgr == "pkg" {
        return "sudo -n pkg install -y ${pkg}"
    }
    if mgr == "brew" {
        return "brew install ${pkg}"
    }
    return ""
}

// 1 if `bin` is on PATH (via `command -v`), else 0.
_have(bin: string) -> int {
    av = list_new()
    list_add(av, "-c")
    list_add(av, "command -v ${bin} >/dev/null 2>&1")
    _o, status, err = run_capture("/bin/sh", av, null)
    list_free(av)
    if err != "" {
        return 0
    }
    if status == 0 {
        return 1
    }
    return 0
}
