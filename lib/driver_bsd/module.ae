// lib/driver_bsd — FreeBSD jail backend.
//
// The BSD arm of the driver split. Same contract as driver_linux —
// idempotent up/down + a liveness probe, all shelling os.run_capture —
// but the resource is a FreeBSD jail over a ZFS dataset.
//
// A jail needs three things to exist: a ZFS dataset to hold its root, a
// populated root filesystem under that dataset's mountpoint, and a
// `jail -c` create call. aeo owns dataset creation and the create/stop
// calls; populating the root (a base userland, or a thin "pkg base"
// install) is the operator's `provision(...)` step — aeo does not ship a
// userland.
//
// Idempotency, mirroring the Linux driver:
//   up    — if `jls -j NAME` shows it running, no-op; else ensure the
//           dataset exists, then `jail -c` it.
//   down  — `jail -r NAME`; an already-stopped jail is success.
//   probe — (int) 1 if `jls -j NAME` exits 0 AND (no health, or the
//           health command exits 0 under `jexec`).
//
// Paths: jail roots live at the dataset's mountpoint. aeo derives the
// mountpoint by convention as /<dataset> unless the operator set one;
// for the common zroot/jails/<name> layout that is /zroot/jails/<name>.
//
// NOTE: jail/jexec/jls/zfs live in /usr/sbin and /sbin; we use absolute
// paths so a non-login ssh PATH (which often omits /usr/sbin) still works.

import std.os (run_capture, getenv)
import std.list
import std.string (string_length)

exports (
    name,
    up, down, probe, exec_capture,
    jls_running_argv, jail_create_argv, jail_remove_argv,
    zfs_create_argv, jexec_health_argv, mountpoint_for
)

name() -> string {
    return "bsd"
}

// Convention: a dataset `zroot/jails/db` mounts at `/zroot/jails/db`.
// (ZFS default mountpoint == /<dataset> unless overridden.) Operators
// who set a custom mountpoint pass the path directly as `root`.
mountpoint_for(dataset: string) -> string {
    return "/${dataset}"
}

// --- pure argv builders ----------------------------------------------

// `jls -j NAME jid` — exits 0 iff a jail named NAME exists/runs.
jls_running_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "-j")
    list_add(av, res_name)
    list_add(av, "jid")
    return av
}

// `zfs create -p DATASET` — -p creates parents, and is idempotent-ish
// (errors if it already exists; we treat that as fine at the call site).
zfs_create_argv(dataset: string) -> ptr {
    av = list_new()
    list_add(av, "create")
    list_add(av, "-p")
    list_add(av, dataset)
    return av
}

// `jail -c name=NAME path=ROOT host.hostname=NAME ip4.addr=IP
//        command=/bin/sh -c CMD persist` — create + start. We use
// persist so the jail stays up after the (possibly short) command;
// liveness is then the jail's existence, probed via jls.
jail_create_argv(res_name: string, root: string, ip: string, start_cmd: string) -> ptr {
    av = list_new()
    list_add(av, "-c")
    list_add(av, "name=${res_name}")
    list_add(av, "path=${root}")
    list_add(av, "host.hostname=${res_name}")
    if string_length(ip) > 0 {
        list_add(av, "ip4.addr=${ip}")
    }
    list_add(av, "persist")
    if string_length(start_cmd) > 0 {
        list_add(av, "exec.start=${start_cmd}")
    }
    return av
}

// `jail -r NAME` — stop + remove a running jail.
jail_remove_argv(res_name: string) -> ptr {
    av = list_new()
    list_add(av, "-r")
    list_add(av, res_name)
    return av
}

// `jexec NAME /bin/sh -c HEALTH` — run the health probe inside the jail.
jexec_health_argv(res_name: string, health: string) -> ptr {
    av = list_new()
    list_add(av, res_name)
    list_add(av, "/bin/sh")
    list_add(av, "-c")
    list_add(av, health)
    return av
}

// --- exec'ing entry points -------------------------------------------

// Bring the jail up idempotently. `dataset` backs the root; `root` is
// the populated jail root path (mountpoint_for(dataset) if ""); `ip` may
// be ""; `start_cmd` may be "". Returns "" on success else an error.
up(res_name: string, dataset: string, root: string, ip: string, start_cmd: string) -> string {
    // Already running? no-op.
    if probe(res_name, "", "") == 1 {
        return ""
    }
    jail_root = root
    if string_length(jail_root) == 0 {
        if string_length(dataset) == 0 {
            return "aeo: jail '${res_name}' has neither root() nor dataset() set"
        }
        jail_root = mountpoint_for(dataset)
    }
    // Ensure the dataset exists (ignore "already exists" failure).
    if string_length(dataset) > 0 {
        zav = zfs_create_argv(dataset)
        _zo, _zs, _ze = _sudo_run("/sbin/zfs", zav)
        list_free(zav)
    }
    // SELF-PROVISION the jail base: if jail_root has no populated FreeBSD base
    // (no /bin/sh inside), fetch the matching base.txz and extract it — the BSD
    // analog of driver_linux's podman self-install ("deploy a jail" makes the
    // substrate ready). Opt-out AEO_JAIL_AUTOBASE=0. Best-effort; jail -c below
    // still fails loudly if the root ends up unusable.
    _ensure_jail_base(jail_root)
    // Create + start the jail.
    cav = jail_create_argv(res_name, jail_root, ip, start_cmd)
    out, status, err = _sudo_run("/usr/sbin/jail", cav)
    list_free(cav)
    if err != "" {
        return "aeo: jail spawn failed for '${res_name}': ${err}"
    }
    if status != 0 {
        return "aeo: 'jail -c' failed for '${res_name}' (exit ${status}): ${out}"
    }
    return ""
}

// Tear the jail down. Absent jail == success.
down(res_name: string) -> string {
    if probe(res_name, "", "") == 0 {
        return ""
    }
    rav = jail_remove_argv(res_name)
    out, status, err = _sudo_run("/usr/sbin/jail", rav)
    list_free(rav)
    if err != "" {
        return "aeo: jail teardown spawn failed for '${res_name}': ${err}"
    }
    if status != 0 {
        return "aeo: 'jail -r' failed for '${res_name}' (exit ${status}): ${out}"
    }
    return ""
}

// Liveness probe. 1 if the jail exists/runs (and the health command, when
// given, exits 0 under jexec), else 0. Plain int (not a tuple) for the
// same reason as driver_linux.probe.
probe(res_name: string, health: string, _unused: string) -> int {
    jav = jls_running_argv(res_name)
    out, status, err = _sudo_run("/usr/sbin/jls", jav)
    list_free(jav)
    if err != "" {
        return 0
    }
    if status != 0 {
        return 0
    }
    if string_length(health) == 0 {
        return 1
    }
    hav = jexec_health_argv(res_name, health)
    hout, hstatus, herr = _sudo_run("/usr/sbin/jexec", hav)
    list_free(hav)
    if herr != "" {
        return 0
    }
    if hstatus == 0 {
        return 1
    }
    return 0
}

// exec_capture — run `cmd` inside the jail via jexec, return its stdout ("" on
// any failure). The per-node operability primitive (`aeo exec <jail> <cmd>`);
// reuses jexec_health_argv (jexec NAME /bin/sh -c CMD) + the self-sudo path.
exec_capture(res_name: string, cmd: string) -> string {
    av = jexec_health_argv(res_name, cmd)
    out, status, err = _sudo_run("/usr/sbin/jexec", av)
    list_free(av)
    if err != "" {
        return ""
    }
    if status != 0 {
        return ""
    }
    return out
}

// --- privilege: self-sudo (like driver_vm) ---------------------------------
//
// jail/jls/jexec/zfs need root. Rather than require the whole aeo binary to run
// as root (sudo <arbitrary-binary> isn't NOPASSWD-grantable), each privileged op
// self-sudos: `sh -c "sudo -n <prog> <args>"`, matching driver_vm. The full
// paths (/usr/sbin/jail etc.) are the exact ones the operator's sudoers grants
// NOPASSWD (see docs/bsd-host-setup.md). This is what un-parks real_jail.ae +
// lets the jail demo run via real `aeo up` unprivileged.
//
// argv is passed DIRECTLY to run_capture("sudo", [...]) — NOT interpolated into
// an `sh -c` string. The old form did `astr = "${list_get(argv,i)}"`, but
// list_get returns a PTR and "${ptr}" yields the element's ADDRESS, not the
// string (the LLM.md list_get footgun) — so jail/jls/jexec args would arrive as
// memory addresses the first time this ran privileged for real. Use list_get_raw
// + list_add_raw to copy element ptrs verbatim, exactly like driver_lxc._sudo_lxc
// and driver_vm's qemu exec. Args with spaces (exec.start=..., a jexec health
// command) survive naturally — argv is a real vector, no shell quoting needed.
// Returns (out, status, err) like run_capture, so the call sites are a drop-in.
_sudo_run(prog: string, argv: ptr) -> {
    full = list_new()
    list_add(full, "-n")
    list_add(full, prog)                   // e.g. "/usr/sbin/jail" — the NOPASSWD path
    n = list_size(argv)
    i = 0
    while i < n {
        a = list_get_raw(argv, i)          // raw ptr to the stored string
        _ = list_add_raw(full, a)          // copy the element ptr verbatim (no interp)
        i = i + 1
    }
    out, status, err = run_capture("sudo", full, null)
    list_free(full)
    return out, status, err
}

// (_squote / _chr removed: the sudo path no longer builds a shell string — argv
// goes straight to run_capture("sudo", [...]) as a real vector, so no per-element
// shell quoting is needed. See _sudo_run above.)

// Self-provision a FreeBSD base into an empty jail root — the BSD "silent setup"
// analog of driver_linux's podman self-install. If <root>/bin/sh already exists
// the root is populated (no-op). Else: mkdir the root, fetch the base.txz for the
// RUNNING release (freebsd-version -u -> e.g. 15.0-RELEASE, from the canonical
// download mirror), and extract it. Retried (network transient). Opt-out
// AEO_JAIL_AUTOBASE=0. Best-effort — the jail -c that follows fails loudly if the
// root is still unusable. The whole thing is ONE sudo sh -c (root: mkdir under
// /usr/local/jails, write into the root, and fetch/tar need root anyway).
_ensure_jail_base(root: string) {
    off = getenv("AEO_JAIL_AUTOBASE")
    if off != null {
        if off == "0" {
            return
        }
    }
    if string_length(root) == 0 {
        return
    }
    av = list_new()
    list_add(av, "-c")
    // freebsd-version -u gives the userland version (e.g. 15.0-RELEASE-p10); strip
    // the -pN patch for the dist path (releases are published as X.Y-RELEASE).
    // NB Aether interpolates ${...} in strings, so shell variables use the
    // BRACELESS form ($rel/$arch/$i) which Aether leaves alone; only ${root} (an
    // Aether param) is interpolated. The URL is built by shell string-concat.
    list_add(av, "[ -x '${root}/bin/sh' ] && exit 0; mkdir -p '${root}'; rel=`freebsd-version -u 2>/dev/null | sed 's/-p[0-9]*$//'`; arch=`uname -m`; i=0; while [ $i -lt 3 ]; do [ -x '${root}/bin/sh' ] && exit 0; fetch -o /tmp/aeo-base.txz \"https://download.freebsd.org/releases/$arch/$rel/base.txz\" && tar -xf /tmp/aeo-base.txz -C '${root}' && rm -f /tmp/aeo-base.txz && exit 0; i=`expr $i + 1`; sleep 5; done")
    _o, _s, _e = _sudo_run("/bin/sh", av)
    list_free(av)
}
